{
  "name": "dsh-memory-layers",
  "version": "1.2.1",
  "type": "module",
  "description": "Layered long-term memory for DeepSeek Harness: a ~600-character hot layer that evicts its own overflow, month-archived cold entries with usage-ranked keyword recall, and extractive day/week/month summaries that keep injected context small.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "summarization",
    "agent-tools",
    "eviction",
    "recall-ranking"
  ],
  "author": "mllun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mllun/dsh-memory-layers.git"
  },
  "homepage": "https://github.com/mllun/dsh-memory-layers#readme",
  "bugs": {
    "url": "https://github.com/mllun/dsh-memory-layers/issues"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/schema.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:schema": "node test/schema.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "permissions": {
      "files": "write",
      "network": "none",
      "commands": "none",
      "credentials": [
        "none"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
